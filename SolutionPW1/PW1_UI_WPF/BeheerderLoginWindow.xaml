<Window x:Class="PW1_UI_WPF.BeheerderLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PW1_UI_WPF"
        mc:Ignorable="d"
        Title="BeheerderLoginWindow" Height="450" Width="800">
    <Grid Background="LightGray">
        <TextBox HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Background="White" Name="loginButton" Content="Log in" HorizontalAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" Width="120" Click="loginButton_Click"/>
        <Button Background="White" Name="goBackButton" Content="Go back" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="goBackButton_Click"/>
    </Grid>
</Window>
